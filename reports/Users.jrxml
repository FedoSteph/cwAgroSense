<jasperReport name="Users" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bb1a8091-5d8e-4b8d-b6a2-2180ae866f52">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MYSQL"/>
	<query language="SQL"><![CDATA[SELECT
sc.scid,
u.name AS farmer_name,
c.cname AS crop_name,
sc.planting_date,
sc.expected_yield,
sc.status
FROM seasonal_crop sc
JOIN farmer f ON sc.fid = f.fid
JOIN user u ON f.uid = u.uid
JOIN crop c ON sc.cid = c.cid
ORDER BY sc.planting_date DESC]]></query>
