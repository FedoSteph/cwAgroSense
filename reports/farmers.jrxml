	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (3)"/>
	<query language="SQL"><![CDATA[SELECT
f.fid,
u.uid,
u.email,
f.contact_no,
f.location
FROM farmer f
JOIN user u ON f.uid = u.uid
ORDER BY f.fid]]></query>
